# Vite forwards browser /api requests to this backend during local development.
# This variable stays on the dev server, so desktop and LAN browsers use the same API.
API_PROXY_TARGET=http://127.0.0.1:5000

# Production builds require an HTTPS backend URL. A missing /api suffix is added.
# Set VITE_API_URL in Cloudflare Pages build variables; it is not needed for npm run dev.
# VITE_ variables are public in the browser; never put secrets here.
VITE_API_URL=

# Public Google Identity Services Web client ID used on the PIN recovery screen.
# This is a client ID, not a secret. Keep its allowed origins restricted in Google Cloud.
VITE_GOOGLE_CLIENT_ID=
